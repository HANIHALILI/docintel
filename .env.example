# Copy to `.env` and fill in real values. `.env` is git-ignored — never commit secrets.
# The VLM endpoint must be OpenAI-compatible (POST /v1/chat/completions).

# --- OpenAI (most common) ---
VLM_MODEL=gpt-4o-mini
VLM_BASE_URL=https://api.openai.com
VLM_API_KEY=sk-REPLACE_ME

# --- Anthropic (OpenAI-compatible endpoint) ---
# VLM_MODEL=claude-sonnet-4-5
# VLM_BASE_URL=https://api.anthropic.com/v1
# VLM_API_KEY=sk-ant-REPLACE_ME

# --- Self-hosted: vLLM / Ollama / LiteLLM proxy ---
# VLM_MODEL=llava                                  # whatever the server serves
# VLM_BASE_URL=http://host.docker.internal:11434/v1  # host.docker.internal reaches the host from a container
# VLM_API_KEY=                                     # leave empty if none

# --- Optional tuning ---
# VLM_CONCURRENCY=8          # max parallel VLM calls
# VLM_MIN_PIXEL_AREA=1000    # skip images smaller than this (pixels)
# VLM_TIMEOUT=60             # seconds per VLM call
